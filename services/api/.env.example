# Postgres connection used by Prisma
DATABASE_URL="postgresql://nexserv:nexserv@localhost:5432/nexserv?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Myra's model provider. "anthropic" is fully implemented; "sarvam" and "grok"
# are architected in src/myra/providers/ but not yet wired to a real API.
MYRA_PROVIDER="anthropic"

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
MYRA_MODEL="claude-sonnet-5"

# Only needed once src/myra/providers/sarvam.ts and grok.ts are implemented.
SARVAM_API_KEY=""
GROK_API_KEY=""

# Server
PORT=4000
CORS_ORIGIN="*"
