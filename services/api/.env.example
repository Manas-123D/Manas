# Postgres connection used by Prisma
DATABASE_URL="postgresql://nexserv:nexserv@localhost:5432/nexserv?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Myra's model provider. "anthropic" and "sarvam" are fully implemented;
# "grok" is architected in src/myra/providers/grok.ts but not yet wired to a real API.
MYRA_PROVIDER="anthropic"

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
MYRA_MODEL="claude-sonnet-5"

# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=""
# Only needed once src/myra/providers/grok.ts is implemented.
GROK_API_KEY=""

# Server
PORT=4000
CORS_ORIGIN="*"
