# Postgres connection used by Prisma
DATABASE_URL="postgresql://nexserv:nexserv@localhost:5432/nexserv?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Myra's model provider. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
MYRA_MODEL="claude-sonnet-5"

# Server
PORT=4000
CORS_ORIGIN="*"
